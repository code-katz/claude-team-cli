#!/usr/bin/env bash
# claude-team — Manage Claude Code team member personas
# https://github.com/code-katz/claude-team-cli

set -euo pipefail

# Bash 4+ required. macOS ships Bash 3.2 at /bin/bash for licensing reasons;
# a current Bash is one 'brew install bash' away.
if [[ -z "${BASH_VERSINFO:-}" ]] || (( BASH_VERSINFO[0] < 4 )); then
  echo "error: claude-team requires Bash 4 or newer (this is ${BASH_VERSION:-not bash})." >&2
  echo "macOS ships Bash 3.2; install a current Bash with: brew install bash" >&2
  exit 1
fi

PROFILES_DIR="${CLAUDE_TEAM_PROFILES:-$HOME/.claude/team}"
CLAUDE_MD="$HOME/.claude/CLAUDE.md"
BRANCHES_INDEX="$HOME/.claude/branches/INDEX.md"
WORKTREES_ROOT="$HOME/.claude/worktrees"
MARKER_START="<!-- CLAUDE-TEAM:START -->"
MARKER_END="<!-- CLAUDE-TEAM:END -->"
COORD_START="<!-- CLAUDE-COORDINATOR:START -->"
COORD_END="<!-- CLAUDE-COORDINATOR:END -->"

# ─── Helpers ────────────────────────────────────────────────────────────────

bold()  { printf '\033[1m%s\033[0m' "$*"; }
green() { printf '\033[32m%s\033[0m' "$*"; }
dim()    { printf '\033[2m%s\033[0m' "$*"; }
red()    { printf '\033[31m%s\033[0m' "$*"; }
yellow() { printf '\033[33m%s\033[0m' "$*"; }

die() { echo "$(red "error:") $*" >&2; exit 1; }

# Claude Code registers subagents and hooks when a session starts, and reads
# slash commands on demand. So a sync activates the slash commands immediately
# and leaves the other two waiting for the next session. Saying so is the whole
# point: a green checkmark on all three reads as "all three are live now".
say_session_scope() {
  echo ""
  echo "$(dim "Live now: slash commands (/akira, /robin, ...). No restart needed.")"
  echo "$(dim "Next session: subagents and the SessionStart hook. Claude Code registers those at startup.")"
}

lowercase() { printf '%s\n' "${1,,}"; }
capitalize() { printf '%s\n' "${1^}"; }

# ─── Shared-state locking ────────────────────────────────────────────────────

# ~/.claude/CLAUDE.md and ~/.claude/branches/INDEX.md are shared by every
# Claude Code session on this machine, and several commands rewrite them
# read-modify-write. Every writer must take this lock, appends included: an
# append is atomic by itself, but an append that lands between a rewriter's
# read and its rename is discarded by that rename. Readers take no lock,
# because a rewrite lands with a rename inside one filesystem, so a reader
# sees either the whole old file or the whole new one.
#
# The lock is a directory. mkdir either creates the directory or fails, in one
# filesystem operation, on Linux and macOS alike. flock is the usual tool for
# this, but stock macOS does not ship it and this project supports macOS.
#
# The kernel does not release a directory lock when the holder dies, so:
#   - the holder records host, PID, and acquisition time in <lock>/owner;
#   - the EXIT, INT, and TERM traps release the lock on every exit except
#     SIGKILL and power loss;
#   - a contender breaks a lock whose holder is a dead process on this host,
#     or whose age exceeds LOCK_STALE_SECONDS. The age rule also covers a lock
#     left by a reboot, where the recorded PID may since have been reassigned
#     to a live process.
#
# The critical sections are a few awk passes over a small file, so a wait of
# seconds already means a holder is stuck rather than queued.
LOCK_WAIT_SECONDS=15
LOCK_STALE_SECONDS=120
LOCK_POLL_SECONDS=0.05
LOCK_HOST="${HOSTNAME:-$(uname -n 2>/dev/null || echo unknown)}"

_LOCK_DIR=""   # non-empty while this process holds a lock
_TMP_FILE=""   # non-empty while a temp file waits for its rename

_lock_owner() { cat "$1/owner" 2>/dev/null || true; }

# True only when the lock holder is provably gone: a dead PID on this host, or
# an acquisition older than LOCK_STALE_SECONDS.
#
# Two states deliberately count as live. An absent lock directory is not
# stale: the next mkdir wins it, and breaking it would delete a directory that
# another contender has since created. A lock whose owner record is not
# readable yet is not stale either: every live holder passes through that
# state between its mkdir and its record write, so breaking on it removes live
# locks under load. lock_acquire handles a holder that died inside that window
# separately, at the deadline.
_lock_is_stale() {
  local lock_dir="$1" host pid started now
  [[ -d "$lock_dir" ]] || return 1
  if ! read -r host pid started < "$lock_dir/owner" 2>/dev/null; then
    return 1
  fi
  now=$(date '+%s')
  if [[ "$started" =~ ^[0-9]+$ ]] && (( now - started > LOCK_STALE_SECONDS )); then
    return 0
  fi
  if [[ "$host" == "$LOCK_HOST" && "$pid" =~ ^[0-9]+$ ]] && ! kill -0 "$pid" 2>/dev/null; then
    return 0
  fi
  return 1
}

# Claim the lock directory. _LOCK_DIR is set before the owner record is
# written, so the traps remove the directory if this process dies in between.
_lock_take() {
  local lock_dir="$1"
  mkdir "$lock_dir" 2>/dev/null || return 1
  _LOCK_DIR="$lock_dir"
  printf '%s %s %s\n' "$LOCK_HOST" "$$" "$(date '+%s')" > "$lock_dir/owner" \
    || die "Cannot write the lock owner record: $lock_dir/owner"
  return 0
}

# Take the lock for a shared file. Waits up to LOCK_WAIT_SECONDS, then fails
# with the holder's identity and the command that clears the lock by hand.
#
# Before it breaks a stale lock, the contender confirms the verdict twice,
# LOCK_POLL_SECONDS apart, with an unchanged owner record, so a lock that
# another contender took in between survives. The residual window is the few
# microseconds between the second check and the removal, and it opens only
# once a holder has already died.
lock_acquire() {
  local target="$1" lock_dir="$1.lock" deadline snapshot broke_once=false
  deadline=$(( SECONDS + LOCK_WAIT_SECONDS ))
  mkdir -p "$(dirname "$lock_dir")"
  while true; do
    if _lock_take "$lock_dir"; then
      return 0
    fi
    if _lock_is_stale "$lock_dir"; then
      snapshot=$(_lock_owner "$lock_dir")
      sleep "$LOCK_POLL_SECONDS"
      if _lock_is_stale "$lock_dir" && [[ "$(_lock_owner "$lock_dir")" == "$snapshot" ]]; then
        rm -rf "$lock_dir"
      fi
      continue
    fi
    if (( SECONDS >= deadline )); then
      # An owner record still missing after the full wait belongs to a holder
      # that died between its mkdir and its record write: no live holder stays
      # in that state for seconds. Break it once, then wait again.
      if [[ "$broke_once" == false && -d "$lock_dir" && ! -s "$lock_dir/owner" ]]; then
        broke_once=true
        rm -rf "$lock_dir"
        deadline=$(( SECONDS + LOCK_WAIT_SECONDS ))
        continue
      fi
      die "Timed out after ${LOCK_WAIT_SECONDS}s waiting for the lock on $target.
Holder (host pid epoch): $(_lock_owner "$lock_dir")
If no other claude-team command is running, remove the lock:
  rm -rf $lock_dir"
    fi
    sleep "$LOCK_POLL_SECONDS"
  done
}

# Release the lock this process holds. The removal is conditional on the owner
# record still naming this process: if a contender broke the lock, the
# directory belongs to that contender and must survive.
lock_release() {
  [[ -n "$_LOCK_DIR" ]] || return 0
  local dir="$_LOCK_DIR" owner_pid
  _LOCK_DIR=""
  owner_pid=$(awk '{print $2; exit}' "$dir/owner" 2>/dev/null || true)
  if [[ "$owner_pid" == "$$" ]]; then
    rm -rf "$dir"
  fi
  return 0
}

# Runs on a normal exit, on die, on a set -e failure, and on Ctrl-C. Nothing
# runs on SIGKILL or power loss; lock_acquire's staleness rule covers those.
_cleanup() {
  lock_release
  if [[ -n "$_TMP_FILE" ]]; then
    rm -f "$_TMP_FILE"
    _TMP_FILE=""
  fi
  return 0
}
trap _cleanup EXIT
trap '_cleanup; exit 130' INT
trap '_cleanup; exit 143' TERM

# Create a temp file in the target's own directory and register it for
# cleanup. mktemp otherwise writes to TMPDIR, which is often tmpfs and so a
# different filesystem from $HOME. mv across filesystems degrades to copy plus
# unlink, which is not atomic: a reader can see a partial file, and an
# interrupted copy leaves one behind.
tmp_beside() {
  local target="$1" dir
  dir=$(dirname "$target")
  mkdir -p "$dir"
  _TMP_FILE=$(mktemp "$dir/.claude-team.XXXXXX")
  printf '%s\n' "$_TMP_FILE"
}

# Put a temp file from tmp_beside in place. Source and target share a
# filesystem, so this is a rename: readers see the old file or the new one.
tmp_commit() {
  mv "$1" "$2"
  _TMP_FILE=""
}

require_profiles_dir() {
  [[ -d "$PROFILES_DIR" ]] || die "Profiles directory not found: $PROFILES_DIR
Run the installer first: bash install.sh"
}

# A profile name is an identifier, not a path: it is the basename of a file in
# PROFILES_DIR. The character check rejects everything else, so a name cannot
# reach the filesystem as '../' traversal, and cannot be read as an option by a
# command that is given it later. The check is a character class rather than
# path resolution because macOS ships no 'readlink -f'.
resolve_name() {
  local input
  input=$(lowercase "$1")
  [[ "$input" =~ ^[a-z0-9][a-z0-9_-]*$ ]] \
    || die "Invalid profile name: '$1'. A name uses letters, digits, '-', and '_', and starts with a letter or digit."
  local profile="$PROFILES_DIR/$input.md"
  [[ -f "$profile" ]] || die "No profile found for '$input'. Run 'claude-team list' to see available team members."
  echo "$profile"
}

# Title parsing. Profile titles use the form "# Name — Role"; both parts
# split at the FIRST em dash so a role may itself contain one.
profile_title() {
  grep -m1 '^# ' "$1" | sed 's/^# //'
}

title_name() {
  printf '%s\n' "${1%% —*}"
}

title_role() {
  printf '%s\n' "${1#*— }"
}

# Print a profile without its trailing "## Greeting" section. That section
# holds the line a persona says at the moment a session switches to it, so it
# belongs only where a session starts now. The section runs to end of file, so
# stopping at its heading is the whole excision. A profile without the heading
# prints unchanged.
profile_without_greeting() {
  awk '/^## Greeting[[:space:]]*$/{exit} {print}' "$1"
}

get_active() {
  [[ -f "$CLAUDE_MD" ]] || { echo ""; return; }
  # Extract the name line from the active block
  local title
  title=$(awk "/$MARKER_START/,/$MARKER_END/" "$CLAUDE_MD" | grep -m1 '^# ' | sed 's/^# //' || true)
  title_name "$title"
}

# Replace the marked block in a file, or append it if absent. All edits go
# through a temp file and land with a rename: a redirection straight onto the
# target would truncate it before the pipeline runs, so any failure could
# destroy the user's file. The lock covers the whole read-modify-write. Two
# sessions writing different blocks of the same file otherwise lose one of
# them, or each fail to see the other's marker and append a second copy.
block_install() {
  local file="$1" start="$2" end="$3" content="$4"
  lock_acquire "$file"
  touch "$file"
  local tmp
  tmp=$(tmp_beside "$file")
  if grep -qF "$start" "$file"; then
    awk -v m="$start" 'index($0, m){exit} {print}' "$file" > "$tmp"
    printf '%s\n%s\n%s\n' "$start" "$content" "$end" >> "$tmp"
    awk -v m="$end" 'found{print} index($0, m){found=1}' "$file" >> "$tmp"
  else
    cat "$file" > "$tmp"
    printf '\n%s\n%s\n%s\n' "$start" "$content" "$end" >> "$tmp"
  fi
  tmp_commit "$tmp" "$file"
  lock_release
}

# Remove the marked block from a file. The new content lands with a rename
# inside one filesystem, so a reader sees the file with the block or without
# it, never a partial file. Blank lines the removed block leaves at
# end-of-file are trimmed; everything above it, including the user's own
# trailing spaces and leading blank lines, is preserved.
block_remove() {
  local file="$1" start="$2" end="$3"
  lock_acquire "$file"
  local tmp
  tmp=$(tmp_beside "$file")
  awk -v s="$start" -v e="$end" '
    index($0, s){skip=1}
    skip && index($0, e){skip=0; next}
    !skip{lines[++n]=$0}
    END{
      while (n > 0 && lines[n] ~ /^[[:space:]]*$/) n--
      for (i = 1; i <= n; i++) print lines[i]
    }
  ' "$file" > "$tmp"
  tmp_commit "$tmp" "$file"
  lock_release
}

# ─── Commands ────────────────────────────────────────────────────────────────

cmd_list() {
  require_profiles_dir
  echo ""
  echo "$(bold "Claude Dev Team") — available members"
  echo ""

  local active
  active=$(get_active)

  for profile in "$PROFILES_DIR"/*.md; do
    [[ -f "$profile" ]] || continue
    local name
    name=$(basename "$profile" .md)
    [[ "$name" == coordinator* ]] && continue  # coordinator profiles are not team members
    # Extract the title line (first # heading) and the role after the dash
    local title role
    title=$(profile_title "$profile")
    role=$(title_role "$title")

    local name_cap
    name_cap=$(capitalize "$name")
    local is_active=false
    if [[ -n "$active" ]]; then
      local active_lower
      active_lower=$(lowercase "$active")
      [[ "$name" == "$active_lower" ]] && is_active=true
    fi
    if [[ "$is_active" == true ]]; then
      printf "  $(green "●") $(bold "%s") — %s $(dim "(active)")\n" "$name_cap" "$role"
    else
      printf "  $(dim "○") $(bold "%s") — %s\n" "$name_cap" "$role"
    fi
  done

  echo ""
  echo "$(dim "Run 'claude-team use <name>' to activate a team member.")"
  echo ""
}

cmd_show() {
  [[ $# -ge 1 ]] || die "Usage: claude-team show <name>"
  local profile
  profile=$(resolve_name "$1")
  echo ""
  cat "$profile"
  echo ""
}

cmd_use() {
  [[ $# -ge 1 ]] || die "Usage: claude-team use <name>"
  local name
  name=$(lowercase "$1")
  local profile
  profile=$(resolve_name "$name")

  # 'use' pins the persona globally, so every future session reads what lands
  # here. The greeting is dropped: pinned, it makes every new session open with
  # the same line forever.
  local content
  content=$(profile_without_greeting "$profile")
  block_install "$CLAUDE_MD" "$MARKER_START" "$MARKER_END" "$content"

  local display_name
  display_name=$(title_name "$(profile_title "$profile")")

  echo ""
  echo "$(green "✓") $(bold "$display_name") is now active."
  echo "$(dim "Start a new Claude Code session to apply the profile.")"
  echo ""
  echo "$(dim "Note: 'use' pins this persona globally (~/.claude/CLAUDE.md) for ALL new sessions.")"
  echo "$(dim "Running parallel sessions with different personas? Use the /akira-style slash")"
  echo "$(dim "commands inside each session instead — they are session-scoped.")"
  echo ""
}

cmd_reset() {
  if ! grep -qF "$MARKER_START" "$CLAUDE_MD" 2>/dev/null; then
    echo ""
    echo "$(dim "No team member is currently active.")"
    echo ""
    return
  fi

  local active
  active=$(get_active)

  block_remove "$CLAUDE_MD" "$MARKER_START" "$MARKER_END"

  echo ""
  if [[ -n "$active" ]]; then
    echo "$(green "✓") $(bold "$active") deactivated."
  else
    echo "$(green "✓") Team member deactivated."
  fi
  echo "$(dim "Start a new Claude Code session to apply.")"
  echo ""
}

cmd_status() {
  local active
  active=$(get_active)

  local coord_mode="off"
  if grep -qF "$COORD_START" "$CLAUDE_MD" 2>/dev/null; then
    if grep -q "CLAUDE-COORD-MODE: prod" "$CLAUDE_MD" 2>/dev/null; then
      coord_mode="prod"
    else
      coord_mode="casual"
    fi
  fi

  echo ""
  if [[ -n "$active" ]]; then
    echo "$(bold "Active team member:") $(green "$active")"
  else
    echo "$(bold "Active team member:") $(dim "none")"
  fi
  if [[ "$coord_mode" == "prod" ]]; then
    echo "$(bold "Coordinator:") $(green "on (prod)") — branch enforcement active"
  elif [[ "$coord_mode" == "casual" ]]; then
    echo "$(bold "Coordinator:") $(green "on (casual)") — branch enforcement off"
  else
    echo "$(bold "Coordinator:") $(dim "off")"
  fi
  echo ""
}

_coordinator_install() {
  local coord_file="$1"
  local mode_label="$2"
  local mode_desc="$3"

  [[ -f "$coord_file" ]] || die "Coordinator profile not found: $coord_file
Run the installer first: bash install.sh"

  local content refreshed=false
  content=$(cat "$coord_file")
  if grep -qF "$COORD_START" "$CLAUDE_MD" 2>/dev/null; then refreshed=true; fi
  block_install "$CLAUDE_MD" "$COORD_START" "$COORD_END" "$content"

  echo ""
  if [[ "$refreshed" == true ]]; then
    echo "$(green "✓") Coordinator $(bold "$mode_label") — profile refreshed."
  else
    echo "$(green "✓") Coordinator $(bold "$mode_label")."
    echo "$(dim "$mode_desc")"
  fi
  echo "$(dim "Start a new Claude Code session to apply.")"
  echo ""
}

cmd_coordinator() {
  local action="${1:-}"
  [[ -n "$action" ]] || die "Usage: claude-team coordinator <on|prod|off>"

  case "$action" in
    on)
      _coordinator_install \
        "$PROFILES_DIR/coordinator.md" \
        "on (casual)" \
        "Claude will proactively suggest team members. Commit directly to main — no branch enforcement."
      ;;

    prod)
      _coordinator_install \
        "$PROFILES_DIR/coordinator-prod.md" \
        "on (prod)" \
        "Claude will enforce branch hygiene: branches required, worktrees for parallel sessions, MR/PR flow."
      ;;

    off)
      if ! grep -qF "$COORD_START" "$CLAUDE_MD" 2>/dev/null; then
        echo ""
        echo "$(dim "Coordinator is already off.")"
        echo ""
        return
      fi

      block_remove "$CLAUDE_MD" "$COORD_START" "$COORD_END"

      echo ""
      echo "$(green "✓") Coordinator $(bold "off")."
      echo "$(dim "Start a new Claude Code session to apply.")"
      echo ""
      ;;

    *)
      die "Unknown coordinator action: $action. Use 'on', 'prod', or 'off'."
      ;;
  esac
}

cmd_install_commands() {
  local repo_dir
  # Resolve the repo directory: script lives in bin/, so go one level up
  repo_dir="$(cd "$(dirname "$(readlink "$0" 2>/dev/null || echo "$0")")/.." && pwd)"
  local commands_src="$repo_dir/commands"
  local commands_dst="$HOME/.claude/commands"

  [[ -d "$commands_src" ]] || die "Commands directory not found: $commands_src
Make sure you are running this from the claude-team-cli repo."

  echo ""
  echo "Installing slash commands to $commands_dst ..."
  mkdir -p "$commands_dst"
  cp "$commands_src"/*.md "$commands_dst/"
  echo "$(green "✓") Slash commands installed:"
  for f in "$commands_dst"/*.md; do
    [[ -f "$f" ]] || continue
    local name
    name=$(basename "$f" .md)
    echo "    $(dim "/")$(bold "$name")"
  done
  echo ""
  echo "Use them in any Claude Code session:"
  echo "  $(dim "/robin")   — switch to Robin (Testing)"
  echo "  $(dim "/akira")   — switch to Akira (Backend)"
  echo "  $(dim "/sasha")   — switch to Sasha (Frontend)"
  echo "  $(dim "/toni")    — switch to Toni (Product Marketing)"
  echo "  $(dim "/river")   — switch to River (Product)"
  echo "  $(dim "/alex")    — switch to Alex (DevOps)"
  echo "  $(dim "/morgan")  — switch to Morgan (Security)"
  echo "  $(dim "/jordan")  — switch to Jordan (Data & ML)"
  echo "  $(dim "/casey")   — switch to Casey (Data Analyst)"
  echo "  $(dim "/quinn")   — switch to Quinn (Project Manager)"
  echo "  $(dim "/sage")    — switch to Sage (Business Advisor)"
  echo "  $(dim "/kai")     — switch to Kai (UX Design)"
  echo "  $(dim "/iris")    — switch to Iris (Brand & Illustration)"
  echo "  $(dim "/team")    — show current team status"
  echo ""
  echo "$(dim "No new session required — switches take effect immediately.")"
  echo ""
}

# ─── Branch helpers ──────────────────────────────────────────────────────────

get_project_name() {
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die "Not inside a git repository."
  basename "$root"
}

# Create the index if it is absent. Read-only commands call this too, so it
# takes no lock. noclobber supplies the exclusion instead: it makes the
# redirect fail rather than truncate when another session created the index
# between the test below and the write.
ensure_branches_index() {
  if [[ ! -f "$BRANCHES_INDEX" ]]; then
    mkdir -p "$(dirname "$BRANCHES_INDEX")"
    set -C
    printf '# Branch Index\n\n| Date | Project | Branch | Plan Slug | Status | Notes |\n|---|---|---|---|---|---|\n' \
      > "$BRANCHES_INDEX" 2>/dev/null || true
    set +C
  fi
}

# Print one field (by number) from the first active index row for a project.
# Fields: | 2=date | 3=project | 4=branch | 5=plan | 6=status | 7=notes |
# Comparison is exact string equality after trimming, never a regex: project
# and branch names legally contain regex metacharacters ('release/1.2.3'),
# which as patterns cross-match other rows or fail to compile at all.
index_active_field() {
  local project="$1" field="$2"
  [[ -f "$BRANCHES_INDEX" ]] || { echo ""; return; }
  awk -F'|' -v proj="$project" -v fld="$field" '
    {
      p = $3; st = $6
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", p)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", st)
      if (p == proj && st == "active") {
        v = $fld
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
        print v
        exit
      }
    }' "$BRANCHES_INDEX"
}

get_active_branch() {
  index_active_field "$1" 4
}

# ─── Branch commands ──────────────────────────────────────────────────────────

cmd_branch_start() {
  [[ $# -ge 1 ]] || die "Usage: claude-team branch start <branch-name> [--plan <slug>]"
  local branch_name="$1"
  shift
  local plan_slug=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --plan)
        [[ $# -ge 2 ]] || die "--plan requires a value"
        plan_slug="$2"
        shift 2
        ;;
      *) die "Unknown option: $1" ;;
    esac
  done

  local project
  project=$(get_project_name)

  # One lock spans the check and the append. Without it two sessions both find
  # no active branch and both register one for the same project.
  lock_acquire "$BRANCHES_INDEX"

  # Block if an active branch already exists for this project
  local existing
  existing=$(get_active_branch "$project")
  if [[ -n "$existing" ]]; then
    die "Active branch '$(bold "$existing")' already exists for '$project'.
Run 'claude-team branch done' or 'claude-team branch abandon' before starting a new branch."
  fi

  ensure_branches_index

  local today
  today=$(date '+%Y-%m-%d')
  printf '| %s | %s | %s | %s | active | |\n' \
    "$today" "$project" "$branch_name" "$plan_slug" >> "$BRANCHES_INDEX"

  lock_release

  echo ""
  echo "$(green "✓") Branch $(bold "$branch_name") registered for $(bold "$project")."
  [[ -n "$plan_slug" ]] && echo "$(dim "  Linked to plan: $plan_slug")"
  echo "$(dim "  All work this session goes on this branch.")"
  echo ""
}

cmd_branch_close() {
  local new_status="$1"  # "merged" or "abandoned"
  local project
  project=$(get_project_name)

  # One lock spans the read, the rewrite, and the rename. Without it a row
  # another session appends after the read is discarded by the rename.
  lock_acquire "$BRANCHES_INDEX"

  local active
  active=$(get_active_branch "$project")
  [[ -n "$active" ]] || die "No active branch found for '$project'. Nothing to close."

  local tmp
  tmp=$(tmp_beside "$BRANCHES_INDEX")
  awk -F'|' -v proj="$project" -v ns="$new_status" '
    {
      p = $3; st = $6
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", p)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", st)
      if (p == proj && st == "active") {
        d=$2; sub(/^[[:space:]]+/,"",d); sub(/[[:space:]]+$/,"",d)
        b=$4; sub(/^[[:space:]]+/,"",b); sub(/[[:space:]]+$/,"",b)
        s=$5; sub(/^[[:space:]]+/,"",s); sub(/[[:space:]]+$/,"",s)
        printf "| %s | %s | %s | %s | %s | |\n", d, p, b, s, ns
        next
      }
      print
    }
  ' "$BRANCHES_INDEX" > "$tmp" || die "Failed to rewrite the branch index: $BRANCHES_INDEX"
  tmp_commit "$tmp" "$BRANCHES_INDEX"

  lock_release

  echo ""
  if [[ "$new_status" == "merged" ]]; then
    echo "$(green "✓") Branch $(bold "$active") marked as merged."
    echo "$(dim "  To delete the local branch:")"
    echo "  git branch -d $active"
    echo "$(dim "  To delete the remote branch:")"
    echo "  git push origin --delete $active"
  else
    echo "$(green "✓") Branch $(bold "$active") marked as abandoned."
    echo "$(dim "  To delete the local branch:")"
    echo "  git branch -D $active"
  fi
  echo ""
}

cmd_branch_done()    { cmd_branch_close "merged"; }
cmd_branch_abandon() { cmd_branch_close "abandoned"; }

cmd_branch_status() {
  local project
  project=$(get_project_name)

  local active
  active=$(get_active_branch "$project")

  echo ""
  if [[ -n "$active" ]]; then
    echo "$(bold "Active branch:") $(green "$active") $(dim "($project)")"
    # Show linked plan if any
    local plan_slug
    plan_slug=$(index_active_field "$project" 5)
    [[ -n "$plan_slug" ]] && echo "$(dim "Linked plan:") $plan_slug"
  else
    echo "$(bold "Active branch:") $(red "none")"
    echo "$(dim "  No branch registered for '$project'.")"
    echo "$(dim "  Start one: claude-team branch start feat/<name>")"
  fi
  echo ""
}

cmd_branch_list() {
  ensure_branches_index
  echo ""
  echo "$(bold "Branch Index")"
  echo ""
  cat "$BRANCHES_INDEX"
  echo ""
  echo "$(dim "Index: $BRANCHES_INDEX")"
  echo ""
}

cmd_branch_guard() {
  local action="${1:-}"
  [[ -n "$action" ]] || die "Usage: claude-team branch guard <install|remove>"

  local git_root
  git_root=$(git rev-parse --show-toplevel 2>/dev/null) || die "Not inside a git repository."
  local hook_file="$git_root/.git/hooks/pre-commit"

  case "$action" in
    install)
      if [[ -f "$hook_file" ]]; then
        grep -q "claude-team" "$hook_file" 2>/dev/null \
          || die "A pre-commit hook already exists at $hook_file (not installed by claude-team). Remove it manually first."
      fi
      local tmp_hook
      tmp_hook=$(tmp_beside "$hook_file")
      cat > "$tmp_hook" << 'HOOK'
#!/usr/bin/env bash
# Installed by claude-team branch guard
# Blocks accidental direct commits on main/master
branch=$(git rev-parse --abbrev-ref HEAD)
if [[ "$branch" == "main" || "$branch" == "master" ]]; then
  echo "error: direct commits to $branch are not allowed." >&2
  echo "Create a feature branch: git checkout -b feat/<name>" >&2
  exit 1
fi
HOOK
      tmp_commit "$tmp_hook" "$hook_file"
      chmod +x "$hook_file"
      echo ""
      echo "$(green "✓") Branch guard installed."
      echo "$(dim "  Direct commits to main/master are now blocked.")"
      echo "$(dim "  Hook: $hook_file")"
      echo ""
      ;;
    remove)
      if [[ ! -f "$hook_file" ]]; then
        echo ""
        echo "$(dim "No pre-commit hook found at $hook_file.")"
        echo ""
        return
      fi
      grep -q "claude-team" "$hook_file" 2>/dev/null \
        || die "Hook at $hook_file was not installed by claude-team. Remove it manually."
      rm "$hook_file"
      echo ""
      echo "$(green "✓") Branch guard removed."
      echo ""
      ;;
    *) die "Unknown guard action: $action. Use 'install' or 'remove'." ;;
  esac
}

cmd_branch() {
  local subcmd="${1:-}"
  [[ -n "$subcmd" ]] || die "Usage: claude-team branch <start|done|abandon|status|list|guard>"
  shift
  case "$subcmd" in
    start)   cmd_branch_start "$@" ;;
    done)    cmd_branch_done ;;
    abandon) cmd_branch_abandon ;;
    status)  cmd_branch_status ;;
    list)    cmd_branch_list ;;
    guard)   cmd_branch_guard "${1:-}" ;;
    *) die "Unknown branch subcommand: $subcmd. Use start|done|abandon|status|list|guard." ;;
  esac
}

# ─── Session helpers ──────────────────────────────────────────────────────────

ensure_worktrees_root() {
  mkdir -p "$WORKTREES_ROOT"
}

get_default_branch() {
  local repo="$1" ref name
  # Prefer the remote's HEAD, then common local names, then the current branch
  if ref=$(git -C "$repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null); then
    echo "${ref#origin/}"
    return
  fi
  for name in main master trunk; do
    if git -C "$repo" show-ref --quiet "refs/heads/$name"; then
      echo "$name"
      return
    fi
  done
  git -C "$repo" symbolic-ref --short HEAD 2>/dev/null || echo "main"
}

sanitize_branch_for_path() {
  echo "$1" | tr '/' '-'
}

get_worktree_path() {
  local project="$1" branch="$2"
  echo "$WORKTREES_ROOT/$project/$(sanitize_branch_for_path "$branch")"
}

read_session_marker() {
  local dir
  dir=$(git rev-parse --show-toplevel 2>/dev/null) || true
  dir="${dir:-$PWD}"
  if [[ -f "$dir/.claude-session" ]]; then
    cat "$dir/.claude-session"
  else
    echo ""
  fi
}

# ─── Launch (dedicated persona session) ──────────────────────────────────────

TIERS_FILE="$PROFILES_DIR/tiers.conf"

get_default_model() {
  local name="$1"
  [[ -f "$TIERS_FILE" ]] || { echo ""; return; }
  awk -v p="$name" '$1 == p { print $2; exit }' "$TIERS_FILE"
}

cmd_launch() {
  [[ $# -ge 1 ]] || die "Usage: claude-team launch <persona> [--task \"...\"] [--worktree <branch>] [--model <model>] [--dry-run]"
  local name profile
  name=$(lowercase "$1")
  shift
  profile=$(resolve_name "$name")

  local model task="" branch="" dry_run=false
  model=$(get_default_model "$name")
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --model)    [[ $# -ge 2 ]] || die "--model requires a value"; model="$2"; shift 2 ;;
      --task)     [[ $# -ge 2 ]] || die "--task requires a value"; task="$2"; shift 2 ;;
      --worktree) [[ $# -ge 2 ]] || die "--worktree requires a branch name"; branch="$2"; shift 2 ;;
      --dry-run)  dry_run=true; shift ;;
      *) die "Unknown option: $1" ;;
    esac
  done

  local name_cap workdir="$PWD"
  name_cap=$(capitalize "$name")

  if [[ -n "$branch" ]]; then
    local repo_root project
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null) \
      || die "--worktree requires running inside a git repo."
    project=$(basename "$repo_root")
    workdir=$(get_worktree_path "$project" "$branch")
    if [[ ! -d "$workdir" ]]; then
      if [[ "$dry_run" == true ]]; then
        echo "$(dim "[dry-run] would create worktree: claude-team session start $branch")"
      else
        cmd_session_start "$branch"
      fi
    fi
  fi

  # The persona rides in as an appended system prompt: session-scoped by
  # construction, survives compaction, and no global state is touched.
  local cmd=(claude --append-system-prompt-file "$profile" -n "$name_cap")
  [[ -n "$model" ]] && cmd+=(--model "$model")
  [[ -n "$task" ]] && cmd+=("$task")

  if [[ "$dry_run" == true ]]; then
    echo ""
    echo "$(bold "Launch plan for $name_cap")"
    echo "  Directory: $workdir"
    printf '  Command:  '
    printf ' %q' "${cmd[@]}"
    printf '\n\n'
    return
  fi

  command -v claude >/dev/null 2>&1 \
    || die "The 'claude' CLI is not on PATH. Install Claude Code first."

  echo ""
  echo "$(green "✓") Launching $(bold "$name_cap")${model:+ on $(bold "$model")} in $workdir"
  echo ""
  cd "$workdir" && exec "${cmd[@]}"
}

# ─── Session commands ──────────────────────────────────────────────────────────

cmd_session_start() {
  [[ $# -ge 1 ]] || die "Usage: claude-team session start <branch-name> [--plan <slug>]"
  local branch_name="$1"
  shift
  local plan_slug=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --plan)
        [[ $# -ge 2 ]] || die "--plan requires a value"
        plan_slug="$2"
        shift 2
        ;;
      *) die "Unknown option: $1" ;;
    esac
  done

  local repo_root project worktree_path
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null) \
    || die "Not in a git repo. Run this from your project's root directory."
  project=$(basename "$repo_root")
  worktree_path=$(get_worktree_path "$project" "$branch_name")

  # Block if this branch is already an active session
  local existing
  existing=$(get_active_branch "$project")
  if [[ -n "$existing" && "$existing" == "$branch_name" ]]; then
    die "Branch '$(bold "$branch_name")' already has an active session.
Run: claude-team session status"
  fi

  ensure_worktrees_root
  mkdir -p "$(dirname "$worktree_path")"

  # Create worktree: track existing local branch, or create new one from the default branch
  if git -C "$repo_root" show-ref --quiet "refs/heads/$branch_name"; then
    git -C "$repo_root" worktree add "$worktree_path" "$branch_name" \
      || die "Failed to create worktree for existing branch '$branch_name'"
  else
    local base_branch
    base_branch=$(get_default_branch "$repo_root")
    git -C "$repo_root" worktree add -b "$branch_name" "$worktree_path" "$base_branch" \
      || die "Failed to create worktree and branch '$branch_name' from '$base_branch'"
  fi

  # Write .claude-session marker inside the worktree
  local started_at
  started_at=$(date -u "+%Y-%m-%dT%H:%M:%SZ")
  printf 'project=%s\nbranch=%s\nworktree_path=%s\nplan_slug=%s\nstarted_at=%s\n' \
    "$project" "$branch_name" "$worktree_path" "$plan_slug" "$started_at" \
    > "$worktree_path/.claude-session"

  # The marker is local state and must never enter history: each session's
  # marker differs, so committed markers produce add/add merge conflicts
  # between session branches. Git reads info/exclude from the COMMON git
  # dir (per-worktree info/exclude is ignored), and the common exclude is
  # repo-local, uncommitted, and covers every worktree at once.
  local common_git_dir
  common_git_dir=$(cd "$worktree_path" && git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
    || common_git_dir=$(cd "$repo_root" && git rev-parse --git-common-dir 2>/dev/null) || common_git_dir=""
  if [[ -n "$common_git_dir" && -d "$common_git_dir" ]]; then
    mkdir -p "$common_git_dir/info"
    if ! grep -qx '.claude-session' "$common_git_dir/info/exclude" 2>/dev/null; then
      echo ".claude-session" >> "$common_git_dir/info/exclude"
    fi
  fi

  # Register in INDEX.md. The append takes the lock even though an append to a
  # file opened O_APPEND cannot be torn: an unlocked append that lands inside
  # another session's read-modify-write window is discarded by its rename.
  # The lock is taken here rather than around the whole command, so creating a
  # worktree, which takes seconds, never blocks another session's index write.
  lock_acquire "$BRANCHES_INDEX"
  ensure_branches_index
  local today
  today=$(date '+%Y-%m-%d')
  printf '| %s | %s | %s | %s | active | worktree |\n' \
    "$today" "$project" "$branch_name" "$plan_slug" >> "$BRANCHES_INDEX"
  lock_release

  echo ""
  echo "$(green "✓") Session started"
  echo "  Branch:   $(bold "$branch_name")"
  echo "  Worktree: $worktree_path"
  echo ""
  echo "  Open in a new Claude Code window:"
  echo "  $(dim "code \"$worktree_path\"")"
  echo ""
}

cmd_session_status() {
  local marker
  marker=$(read_session_marker)
  echo ""
  if [[ -n "$marker" ]]; then
    echo "$(bold "Active session")"
    while IFS='=' read -r key val; do
      [[ -n "$key" ]] && printf '  %-16s %s\n' "$key" "$val"
    done <<< "$marker"
  else
    echo "$(bold "Active session:") $(red "none")"
    echo "  $(dim "Not in a session worktree.")"
    echo "  $(dim "Start one: claude-team session start <branch>")"
  fi
  echo ""
}

cmd_session_done() {
  local worktree_path
  worktree_path=$(git rev-parse --show-toplevel 2>/dev/null) \
    || die "Not in a git repo."

  [[ -f "$worktree_path/.claude-session" ]] \
    || die "No .claude-session marker found.
Run this from inside a session worktree, or use 'claude-team branch done' for non-worktree branches."

  local project branch
  project=$(grep '^project=' "$worktree_path/.claude-session" | cut -d= -f2)
  branch=$(grep '^branch=' "$worktree_path/.claude-session" | cut -d= -f2)

  # Warn on uncommitted changes
  if ! git -C "$worktree_path" diff --quiet 2>/dev/null || \
     ! git -C "$worktree_path" diff --cached --quiet 2>/dev/null; then
    echo "$(red "⚠") Uncommitted changes in worktree." >&2
    echo "  Commit or stash before closing the session." >&2
    exit 1
  fi

  # Find main repo root (git-common-dir points to main .git)
  local git_common_dir repo_root
  git_common_dir=$(git -C "$worktree_path" rev-parse --git-common-dir 2>/dev/null)
  repo_root=$(dirname "$git_common_dir")

  # Mark merged in INDEX.md. The lock spans the rewrite and the rename, so a
  # row another session appends in between is not discarded.
  lock_acquire "$BRANCHES_INDEX"
  local tmp
  tmp=$(tmp_beside "$BRANCHES_INDEX")
  awk -F'|' -v proj="$project" -v br="$branch" '
    {
      p = $3; b = $4; st = $6
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", p)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", b)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", st)
      if (p == proj && b == br && st == "active") {
        d=$2; sub(/^[[:space:]]+/,"",d); sub(/[[:space:]]+$/,"",d)
        s=$5; sub(/^[[:space:]]+/,"",s); sub(/[[:space:]]+$/,"",s)
        printf "| %s | %s | %s | %s | merged | worktree |\n", d, p, b, s
        next
      }
      print
    }
  ' "$BRANCHES_INDEX" > "$tmp" || die "Failed to rewrite the branch index: $BRANCHES_INDEX"
  tmp_commit "$tmp" "$BRANCHES_INDEX"
  lock_release

  # Remove worktree (must be called from outside the worktree)
  git -C "$repo_root" worktree remove "$worktree_path" 2>/dev/null \
    || git -C "$repo_root" worktree remove "$worktree_path" --force

  echo ""
  echo "$(green "✓") Session closed: $(bold "$branch")"
  echo "  $(dim "Worktree removed: $worktree_path")"
  echo ""
  echo "  Ready to tag this release?"
  echo "  $(dim "  git tag <descriptive-name> && git push origin <tag>")"
  echo ""
}

cmd_session_list() {
  ensure_worktrees_root
  echo ""
  echo "$(bold "Active sessions")"
  echo ""
  if [[ ! -f "$BRANCHES_INDEX" ]]; then
    echo "  $(dim "(none)")"
    echo ""
    return
  fi
  # One awk pass extracts all active rows as tab-separated project/branch
  # pairs; the loop then only formats, with no per-line subshells.
  local rows
  rows=$(awk -F'|' '
    {
      st = $6
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", st)
      if (st == "active") {
        p = $3; b = $4
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", p)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", b)
        print p "\t" b
      }
    }' "$BRANCHES_INDEX")
  local found=0 project branch worktree_path
  while IFS=$'\t' read -r project branch; do
    [[ -n "$project" ]] || continue
    worktree_path=$(get_worktree_path "$project" "$branch")
    if [[ -d "$worktree_path" ]]; then
      printf '  %-25s  %-40s  %s\n' "$(bold "$project")" "$branch" "$(dim "$worktree_path")"
    else
      printf '  %-25s  %-40s  %s\n' "$(bold "$project")" "$branch" "$(dim "(no worktree)")"
    fi
    found=1
  done <<< "$rows"
  [[ $found -eq 0 ]] && echo "  $(dim "(none)")"
  echo ""
}

cmd_session() {
  local subcmd="${1:-}"
  [[ -n "$subcmd" ]] || die "Usage: claude-team session <start|status|done|list>"
  shift
  case "$subcmd" in
    start)  cmd_session_start "$@" ;;
    status) cmd_session_status ;;
    done)   cmd_session_done ;;
    list)   cmd_session_list ;;
    *) die "Unknown session subcommand: $subcmd. Use start|status|done|list." ;;
  esac
}

# Regenerate agents from profiles, then copy all three installed surfaces from
# the clone into ~/.claude. A persona exists as three self-contained files
# (profile, slash command, subagent), so editing one installed copy leaves the
# other two stale with nothing to warn you. install.sh delegates here so the
# copy logic lives in one place and cannot drift from what users run.
cmd_sync() {
  local repo_dir gen commands_dst agents_dst
  repo_dir="$(cd "$(dirname "$(readlink "$0" 2>/dev/null || echo "$0")")/.." && pwd)"
  gen="$repo_dir/scripts/generate-agents.sh"
  commands_dst="$HOME/.claude/commands"
  agents_dst="$HOME/.claude/agents"

  [[ -d "$repo_dir/profiles" ]] || die "Profiles directory not found: $repo_dir/profiles
Make sure you are running this from the claude-team-cli repo."

  echo ""
  # Regenerate first: agents/ is derived from profiles/, so syncing without this
  # would install subagents that lag the profile edit that prompted the sync.
  if [[ -f "$gen" ]]; then
    bash "$gen" >/dev/null || die "generate-agents.sh failed; nothing was synced."
    echo "$(green "✓") Subagents regenerated from $(dim "$repo_dir/profiles")"
  else
    echo "$(yellow "!") $gen not found; syncing the existing agents unchanged."
  fi

  mkdir -p "$PROFILES_DIR"
  cp "$repo_dir/profiles"/*.md "$PROFILES_DIR/"
  if [[ -f "$repo_dir/profiles/tiers.conf" ]]; then
    cp "$repo_dir/profiles/tiers.conf" "$PROFILES_DIR/"
  fi
  echo "$(green "✓") Profiles synced to $(dim "$PROFILES_DIR")"

  if [[ -d "$repo_dir/agents" ]]; then
    mkdir -p "$agents_dst"
    cp "$repo_dir/agents"/*.md "$agents_dst/"
    echo "$(green "✓") Subagents synced to $(dim "$agents_dst")"
  fi

  mkdir -p "$commands_dst"
  cp "$repo_dir/commands"/*.md "$commands_dst/"
  echo "$(green "✓") Slash commands synced to $(dim "$commands_dst")"
  say_session_scope
  echo ""
  echo "$(dim "Edit profiles in $repo_dir/profiles, then rerun: claude-team sync")"
  echo ""
}

# Register bin/team-session-start as a SessionStart hook in ~/.claude/settings.json.
# hooks/hooks.json covers the plugin install path only, where CLAUDE_PLUGIN_ROOT
# resolves; install.sh users need the absolute path written into settings instead.
cmd_install_hook() {
  local repo_dir hook settings
  repo_dir="$(cd "$(dirname "$(readlink "$0" 2>/dev/null || echo "$0")")/.." && pwd)"
  hook="$repo_dir/bin/team-session-start"
  settings="$HOME/.claude/settings.json"

  [[ -f "$hook" ]] || die "Session hook not found: $hook
Make sure you are running this from the claude-team-cli repo."
  chmod +x "$hook"

  if ! command -v python3 >/dev/null 2>&1; then
    echo "$(yellow "!") python3 not found, so settings.json cannot be merged safely."
    echo "  Add this SessionStart hook to $settings by hand:"
    echo ""
    echo "    $(dim "{\"hooks\":{\"SessionStart\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"$hook\"}]}]}}")"
    echo ""
    return 0
  fi

  mkdir -p "$(dirname "$settings")"
  # Merge rather than overwrite: settings.json is the user's file, and a
  # reinstall or a moved clone must replace our stale entry, not stack on it.
  python3 - "$settings" "$hook" <<'PY'
import json, os, sys, tempfile

settings_path, hook_path = sys.argv[1], sys.argv[2]

try:
    with open(settings_path) as f:
        settings = json.load(f)
    if not isinstance(settings, dict):
        raise ValueError("settings.json is not a JSON object")
except FileNotFoundError:
    settings = {}
except (ValueError, OSError) as e:
    sys.exit(f"error: cannot parse {settings_path} ({e}). Fix or move it, then rerun.")

hooks = settings.setdefault("hooks", {})
starts = hooks.setdefault("SessionStart", [])
if not isinstance(starts, list):
    sys.exit(f"error: hooks.SessionStart in {settings_path} is not a list. Fix it, then rerun.")


def ours(matcher):
    """True when this entry points at any team-session-start, including a stale path."""
    return any(
        os.path.basename(str(h.get("command", "")).strip('"')) == "team-session-start"
        for h in matcher.get("hooks", [])
        if isinstance(h, dict)
    )


starts[:] = [m for m in starts if not (isinstance(m, dict) and ours(m))]
starts.append({"hooks": [{"type": "command", "command": hook_path}]})

# Atomic replace, so an interrupted write cannot truncate the user's settings.
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(settings_path) or ".")
with os.fdopen(fd, "w") as f:
    json.dump(settings, f, indent=2)
    f.write("\n")
os.replace(tmp, settings_path)
PY

  echo "$(green "✓") SessionStart hook registered: $(dim "$settings")"
  # A SessionStart hook cannot fire in the session that registers it, so a bare
  # checkmark here reads as "it ran" when nothing has run yet.
  echo "$(dim "  Runs from your next Claude Code session onward, not this one.")"
}

cmd_help() {
  echo ""
  echo "$(bold "claude-team") — Manage Claude Code team member personas"
  echo ""
  echo "$(bold "Usage:")"
  echo "  claude-team list                    List all available team members"
  echo "  claude-team show <name>             Display a team member's full profile"
  echo "  claude-team use <name>              Activate a team member in Claude Code"
  echo "  claude-team reset                   Deactivate the current team member"
  echo "  claude-team status                  Show active team member and coordinator state"
  echo "  claude-team coordinator on          Enable coordinator (casual — no branch enforcement)"
  echo "  claude-team coordinator prod        Enable coordinator (prod — branch enforcement on)"
  echo "  claude-team coordinator off         Disable coordinator"
  echo "  claude-team sync                    Regenerate subagents and reinstall profiles, commands, and agents"
  echo "  claude-team install-commands        Install slash commands to ~/.claude/commands/"
  echo "  claude-team install-hook            Register the SessionStart hook in ~/.claude/settings.json"
  echo ""
  echo "$(bold "Dedicated persona sessions:")"
  echo "  claude-team launch <persona>        Open a Claude Code session with the persona baked in"
  echo "  claude-team launch <persona> --task \"...\"          Start with an initial prompt"
  echo "  claude-team launch <persona> --worktree <branch>   Launch inside an isolated worktree"
  echo "  claude-team launch <persona> --model <model>       Override the persona's tier default"
  echo "  claude-team launch <persona> --dry-run             Print the launch command, don't run"
  echo "                                     $(dim "Tier defaults: profiles/tiers.conf (Fable/Opus/Sonnet)")"
  echo ""
  echo "$(bold "Parallel sessions (worktrees):")"
  echo "  claude-team session start <name>   Create a worktree + branch for an isolated session"
  echo "  claude-team session start <name> --plan <slug>"
  echo "                                     Link the session to an archived plan"
  echo "  claude-team session status         Show current session details (branch, worktree path)"
  echo "  claude-team session done           Close session: mark merged, remove worktree"
  echo "  claude-team session list           List all active sessions across projects"
  echo ""
  echo "$(bold "Branch hygiene (single-session):")"
  echo "  claude-team branch start <name>    Register a branch for the current project"
  echo "  claude-team branch start <name> --plan <slug>"
  echo "                                     Register a branch linked to an archived plan"
  echo "  claude-team branch done            Mark active branch as merged; print delete commands"
  echo "  claude-team branch abandon         Mark active branch as abandoned; print delete commands"
  echo "  claude-team branch status          Show active branch for the current project"
  echo "  claude-team branch list            Show full branch index (~/.claude/branches/INDEX.md)"
  echo "  claude-team branch guard install   Install pre-commit hook blocking commits on main/master"
  echo "  claude-team branch guard remove    Remove the pre-commit hook"
  echo ""
  echo "$(bold "Examples:")"
  echo "  claude-team use robin               Activate Robin (Testing)"
  echo "  claude-team use akira               Activate Akira (Backend)"
  echo "  claude-team use sasha               Activate Sasha (Frontend)"
  echo "  claude-team use toni                Activate Toni (Product Marketing)"
  echo "  claude-team use river               Activate River (Product)"
  echo "  claude-team use alex                Activate Alex (DevOps)"
  echo "  claude-team use morgan              Activate Morgan (Security)"
  echo "  claude-team use jordan              Activate Jordan (Data & ML)"
  echo "  claude-team use casey               Activate Casey (Data Analyst)"
  echo "  claude-team use quinn               Activate Quinn (Project Manager)"
  echo "  claude-team use sage                Activate Sage (Business Advisor)"
  echo "  claude-team use kai                 Activate Kai (UX Design)"
  echo "  claude-team use iris                Activate Iris (Brand & Illustration)"
  echo "  claude-team coordinator on          Enable coordinator (casual — commit to main, no branch gate)"
  echo "  claude-team coordinator prod        Enable coordinator (prod — branch required before code)"
  echo "  claude-team reset                   Return to default Claude behavior"
  echo "  claude-team install-commands        Install all slash commands to ~/.claude/commands/"
  echo ""
  echo "$(dim "Profiles are stored in: $PROFILES_DIR")"
  echo "$(dim "Active profile is injected into: $CLAUDE_MD")"
  echo ""
}

# ─── Dispatch ────────────────────────────────────────────────────────────────

case "${1:-help}" in
  list)             cmd_list ;;
  show)             cmd_show "${2:-}" ;;
  use)              cmd_use "${2:-}" ;;
  reset)            cmd_reset ;;
  status)           cmd_status ;;
  coordinator)      cmd_coordinator "${2:-}" ;;
  install-commands) cmd_install_commands ;;
  install-hook)     cmd_install_hook ;;
  sync)             cmd_sync ;;
  launch)           shift; cmd_launch "$@" ;;
  branch)           shift; cmd_branch "$@" ;;
  session)          shift; cmd_session "$@" ;;
  help|--help|-h)   cmd_help ;;
  *) die "Unknown command: $1. Run 'claude-team help' for usage." ;;
esac
